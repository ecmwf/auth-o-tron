{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        }
      },
      "$ref": "#/$defs/ConfigV1",
      "required": [
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "2.0.0"
        }
      },
      "$ref": "#/$defs/ConfigV2",
      "required": [
        "version"
      ]
    }
  ],
  "$defs": {
    "StoreConfig": {
      "description": "A wrapper for the store configuration:\n- enabled: if false, the store is effectively disabled (NoStore).\n- backend: the actual store backend (MongoDB, etc.).",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "mongo"
                }
              },
              "$ref": "#/$defs/MongoDBConfig",
              "required": [
                "type"
              ]
            }
          ]
        },
        {}
      ]
    },
    "MongoDBConfig": {
      "description": "The config struct for MongoDB connections.\nContains the URI and database name.",
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "database": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "database"
      ]
    },
    "ServiceConfig": {
      "description": "A declaration of services we might need (e.g., to store scopes).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "scopes"
      ]
    },
    "ProviderConfig": {
      "description": "Configuration options for each authentication provider.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ecmwf-api"
            }
          },
          "$ref": "#/$defs/EcmwfApiProviderConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ecmwf-token-generator"
            }
          },
          "$ref": "#/$defs/EcmwfTokenGeneratorProviderConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "efas-api"
            }
          },
          "$ref": "#/$defs/EFASApiProviderConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "jwt"
            }
          },
          "$ref": "#/$defs/JWTAuthConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "openid-offline"
            }
          },
          "$ref": "#/$defs/OpenIDOfflineProviderConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plain"
            }
          },
          "$ref": "#/$defs/PlainAuthConfig",
          "required": [
            "type"
          ]
        }
      ]
    },
    "EcmwfApiProviderConfig": {
      "description": "The config needed for the ECMWF API provider (who-am-i endpoint).",
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "realm",
        "name"
      ]
    },
    "EcmwfTokenGeneratorProviderConfig": {
      "description": "Config for an ECMWF Token Generator provider that validates tokens through the token generator API.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "cert_uri": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "token_generator_url": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "cert_uri",
        "client_id",
        "client_secret",
        "token_generator_url",
        "realm"
      ]
    },
    "EFASApiProviderConfig": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "name",
        "realm"
      ]
    },
    "JWTAuthConfig": {
      "description": "JWT config structure for external usage",
      "type": "object",
      "properties": {
        "cert_uri": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "iam_realm": {
          "type": "string"
        }
      },
      "required": [
        "cert_uri",
        "realm",
        "name",
        "iam_realm"
      ]
    },
    "OpenIDOfflineProviderConfig": {
      "description": "Config for an OpenID provider that also supports offline tokens.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "cert_uri": {
          "type": "string"
        },
        "public_client_id": {
          "type": "string"
        },
        "private_client_id": {
          "type": "string"
        },
        "private_client_secret": {
          "type": "string"
        },
        "iam_url": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "cert_uri",
        "public_client_id",
        "private_client_id",
        "private_client_secret",
        "iam_url",
        "realm"
      ]
    },
    "PlainUserEntry": {
      "description": "Represents a single user entry (username + password).",
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "roles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "username",
        "password"
      ]
    },
    "PlainAuthConfig": {
      "description": "PlainAuthConfig defines the data for Basic authentication.",
      "type": "object",
      "properties": {
        "name": {
          "description": "A friendly name for logs.",
          "type": "string"
        },
        "realm": {
          "description": "The realm associated with this provider.",
          "type": "string"
        },
        "users": {
          "description": "A list of username/password pairs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlainUserEntry"
          }
        }
      },
      "required": [
        "name",
        "realm",
        "users"
      ]
    },
    "AugmenterConfig": {
      "description": "Configuration options for augmenters (e.g. an LDAP roles augmenter).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ldap"
            }
          },
          "$ref": "#/$defs/LDAPAugmenterConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plain"
            }
          },
          "$ref": "#/$defs/PlainAugmenterConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plain_advanced"
            }
          },
          "$ref": "#/$defs/PlainAdvancedAugmenterConfig",
          "required": [
            "type"
          ]
        }
      ]
    },
    "LDAPAugmenterConfig": {
      "description": "Configuration required to connect to LDAP and fetch user roles.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "search_base": {
          "type": "string"
        },
        "filter": {
          "type": [
            "string",
            "null"
          ]
        },
        "filters": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "bind_dn": {
          "type": [
            "string",
            "null"
          ]
        },
        "ldap_password": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "realm",
        "uri",
        "search_base",
        "ldap_password"
      ]
    },
    "PlainAugmenterConfig": {
      "description": "PlainAugmenterConfig defines the data for additional roles.",
      "type": "object",
      "properties": {
        "name": {
          "description": "A friendly name for logs.",
          "type": "string"
        },
        "realm": {
          "description": "The realm associated with this provider.",
          "type": "string"
        },
        "roles": {
          "description": "A list of roles and users.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "name",
        "realm",
        "roles"
      ]
    },
    "PlainAdvancedAugmenterMatcher": {
      "type": "object",
      "properties": {
        "username": {
          "description": "Users whose names trigger augmentation.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "role": {
          "description": "Existing roles that trigger augmentation.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "PlainAdvancedAugmenterAugment": {
      "type": "object",
      "properties": {
        "roles": {
          "description": "Roles to append (deduped).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "attributes": {
          "description": "Attributes to upsert (overwrite existing keys).",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "PlainAdvancedAugmenterConfig": {
      "description": "PlainAdvancedAugmenterConfig defines matching and augmentation rules.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/PlainAdvancedAugmenterMatcher"
        },
        "augment": {
          "$ref": "#/$defs/PlainAdvancedAugmenterAugment"
        }
      },
      "required": [
        "name",
        "realm",
        "match",
        "augment"
      ]
    },
    "JWTConfig": {
      "description": "A simple definition for JWT usage in tokens.",
      "type": "object",
      "properties": {
        "iss": {
          "type": "string"
        },
        "aud": {
          "type": [
            "string",
            "null"
          ]
        },
        "exp": {
          "type": "integer",
          "format": "int64"
        },
        "secret": {
          "type": "string"
        }
      },
      "required": [
        "iss",
        "exp",
        "secret"
      ]
    },
    "LoggingConfig": {
      "description": "LoggingConfig controls how we initialize tracing/logging.",
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "service_name": {
          "type": "string",
          "default": "authotron"
        },
        "service_version": {
          "type": "string",
          "default": "0.3.7"
        }
      },
      "required": [
        "level",
        "format"
      ]
    },
    "AuthConfig": {
      "description": "Configuration for the authentication timeout.\nThis is used for select_ok operations in the auth module,\nand we kill ongoing futures if they take too long.\n\nNote:\n- The attribute `#[serde(default = \"default_timeout_in_ms\")]` ensures that if\n  the `timeout_in_ms` key is missing during deserialization, it gets set to 5000.\n- However, when the entire auth section is omitted, Serde calls `AuthConfig::default()`.\n  Therefore, we manually implement Default for AuthConfig so that AuthConfig::default()\n  returns a timeout of 5000 instead of the primitive default (0).",
      "type": "object",
      "properties": {
        "timeout_in_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 5000
        }
      }
    },
    "ConfigV1": {
      "type": "object",
      "properties": {
        "store": {
          "$ref": "#/$defs/StoreConfig"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceConfig"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderConfig"
          }
        },
        "augmenters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AugmenterConfig"
          },
          "default": []
        },
        "bind_address": {
          "type": "string"
        },
        "jwt": {
          "$ref": "#/$defs/JWTConfig"
        },
        "include_legacy_headers": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "logging": {
          "$ref": "#/$defs/LoggingConfig"
        },
        "auth": {
          "$ref": "#/$defs/AuthConfig",
          "default": {
            "timeout_in_ms": 5000
          }
        }
      },
      "required": [
        "store",
        "services",
        "providers",
        "bind_address",
        "jwt",
        "logging"
      ]
    },
    "ServerConfig": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "default": "0.0.0.0"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "port"
      ]
    },
    "MetricsConfig": {
      "description": "Controls the dedicated metrics/health server on a separate port.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 9090
        }
      }
    },
    "UiConfig": {
      "description": "Controls branding, trusted browser sign-in links, and optional direct login.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "branding": {
          "$ref": "#/$defs/BrandingConfig",
          "default": {
            "application_name": "Auth-O-Tron",
            "logo_url": null,
            "title": null,
            "description": null
          }
        },
        "sign_in_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrowserSignInAction"
          },
          "default": []
        },
        "ecmwf_api_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectLoginConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "basic": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectLoginConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "browser_session": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserSessionConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "BrandingConfig": {
      "description": "Application-owned branding; all text is rendered as escaped plain text.",
      "type": "object",
      "properties": {
        "application_name": {
          "type": "string",
          "default": "Auth-O-Tron"
        },
        "logo_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiUrl"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "UiUrl": {
      "description": "A URL for escaped UI image and navigation attributes.\n\nHTTPS URLs and root-relative paths such as `/assets/aviso.png` are accepted.\nScheme-relative URLs such as `//other.example/logo.png`, script URLs such\nas `javascript:alert(1)`, and URLs containing credentials are rejected.",
      "type": "string"
    },
    "BrowserSignInAction": {
      "description": "An operator-configured entry into an application's browser login flow.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "start_url": {
          "$ref": "#/$defs/UiUrl"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "start_url"
      ]
    },
    "DirectLoginConfig": {
      "description": "Direct browser login selects one configured provider, never a submitted URL.",
      "type": "object",
      "properties": {
        "provider_name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider_name"
      ]
    },
    "BrowserSessionConfig": {
      "description": "One origin and absolute session lifetime shared by all direct login flows.",
      "type": "object",
      "properties": {
        "public_origin": {
          "$ref": "#/$defs/UiUrl"
        },
        "session_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 60,
          "maximum": 86400,
          "default": 300
        },
        "backend": {
          "$ref": "#/$defs/BrowserBackendConfig"
        },
        "transaction_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 30,
          "maximum": 900,
          "default": 300
        },
        "max_forms": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 1024
        },
        "max_sessions": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 1024
        },
        "max_forms_per_window": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 120
        },
        "max_logins_per_window": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 60
        },
        "rate_window_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 3600,
          "default": 60
        },
        "max_inflight_logins": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 256,
          "default": 8
        },
        "max_shared_inflight_logins": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 1,
          "maximum": 65536,
          "default": null
        },
        "verification_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 30,
          "default": 10
        }
      },
      "additionalProperties": false,
      "required": [
        "public_origin",
        "backend"
      ]
    },
    "BrowserBackendConfig": {
      "description": "A single primary endpoint; Cluster and Sentinel discovery are not supported.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "memory"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "key_prefix": {
              "type": "string"
            },
            "password": {
              "type": "string",
              "writeOnly": true
            },
            "connect_timeout_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1,
              "maximum": 30000,
              "default": 2000
            },
            "operation_timeout_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1,
              "maximum": 10000,
              "default": 1000
            },
            "type": {
              "type": "string",
              "const": "valkey"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "key_prefix",
            "password"
          ]
        }
      ]
    },
    "OAuthConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "authorization_code_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 30,
          "maximum": 300,
          "default": 60
        },
        "access_token_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 60,
          "maximum": 3600,
          "default": 300
        },
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OAuthClient"
          },
          "maxItems": 64,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "OAuthClient": {
      "description": "Locally preregistered public client; token endpoint authentication is `none`.",
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "display_name": {
          "type": "string"
        },
        "application_type": {
          "$ref": "#/$defs/ApplicationType",
          "default": "web"
        },
        "redirect_uris": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "additionalProperties": false,
      "required": [
        "client_id",
        "display_name",
        "redirect_uris"
      ]
    },
    "ApplicationType": {
      "description": "Uses the OpenID Connect `application_type` terminology.",
      "type": "string",
      "enum": [
        "web",
        "native"
      ]
    },
    "ConfigV2": {
      "type": "object",
      "properties": {
        "store": {
          "$ref": "#/$defs/StoreConfig"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceConfig"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderConfig"
          }
        },
        "augmenters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AugmenterConfig"
          },
          "default": []
        },
        "server": {
          "$ref": "#/$defs/ServerConfig"
        },
        "metrics": {
          "$ref": "#/$defs/MetricsConfig",
          "default": {
            "enabled": true,
            "port": 9090
          }
        },
        "jwt": {
          "$ref": "#/$defs/JWTConfig"
        },
        "include_legacy_headers": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "logging": {
          "$ref": "#/$defs/LoggingConfig"
        },
        "auth": {
          "$ref": "#/$defs/AuthConfig",
          "default": {
            "timeout_in_ms": 5000
          }
        },
        "ui": {
          "$ref": "#/$defs/UiConfig",
          "default": {
            "enabled": false,
            "branding": {
              "application_name": "Auth-O-Tron",
              "logo_url": null,
              "title": null,
              "description": null
            },
            "sign_in_actions": []
          }
        },
        "oauth": {
          "$ref": "#/$defs/OAuthConfig",
          "default": {
            "enabled": false,
            "issuer": null,
            "authorization_code_ttl_seconds": 60,
            "access_token_ttl_seconds": 300,
            "clients": []
          }
        }
      },
      "required": [
        "store",
        "services",
        "providers",
        "server",
        "jwt",
        "logging"
      ]
    }
  }
}
