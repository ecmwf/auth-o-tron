{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        }
      },
      "$ref": "#/$defs/ConfigV1",
      "required": [
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "2.0.0"
        }
      },
      "$ref": "#/$defs/ConfigV2",
      "required": [
        "version"
      ]
    }
  ],
  "$defs": {
    "StoreConfig": {
      "description": "A wrapper for the store configuration:\n- enabled: if false, the store is effectively disabled (NoStore).\n- backend: the actual store backend (MongoDB, etc.).",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "mongo"
                }
              },
              "$ref": "#/$defs/MongoDBConfig",
              "required": [
                "type"
              ]
            }
          ]
        },
        {}
      ]
    },
    "MongoDBConfig": {
      "description": "The config struct for MongoDB connections.\nContains the URI and database name.",
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "database": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "database"
      ]
    },
    "ServiceConfig": {
      "description": "A declaration of services we might need (e.g., to store scopes).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "scopes"
      ]
    },
    "ProviderConfig": {
      "description": "Configuration options for each authentication provider.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ecmwf-api"
            }
          },
          "$ref": "#/$defs/EcmwfApiProviderConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ecmwf-token-generator"
            },
            "browser": {
              "description": "Direct browser sign-in is not supported for this provider type; only `null` is accepted.",
              "type": "null"
            }
          },
          "$ref": "#/$defs/EcmwfTokenGeneratorProviderConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "efas-api"
            },
            "browser": {
              "description": "Direct browser sign-in is not supported for this provider type; only `null` is accepted.",
              "type": "null"
            }
          },
          "$ref": "#/$defs/EFASApiProviderConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "jwt"
            },
            "browser": {
              "description": "Direct browser sign-in is not supported for this provider type; only `null` is accepted.",
              "type": "null"
            }
          },
          "$ref": "#/$defs/JWTAuthConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "openid-offline"
            },
            "browser": {
              "description": "Direct browser sign-in is not supported for this provider type; only `null` is accepted.",
              "type": "null"
            }
          },
          "$ref": "#/$defs/OpenIDOfflineProviderConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plain"
            }
          },
          "$ref": "#/$defs/PlainAuthConfig",
          "required": [
            "type"
          ]
        }
      ]
    },
    "ProviderBrowserConfig": {
      "description": "Offers a `plain` or `ecmwf-api` provider as a direct browser sign-in method.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable method id used in `/login/method/{id}`, form flow tags and the\n`method` metric label; unique across providers.",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "not": {
            "enum": [
              "callback",
              "new",
              "account"
            ]
          }
        },
        "label": {
          "description": "Chooser button text, trimmed, 1-64 characters, no control characters.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "refresh_max_lifetime_seconds": {
          "description": "Upper bound on the absolute lifetime of OAuth refresh-token families started\nby a login with this method; the client's `absolute_ttl_seconds` still applies.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 300,
          "maximum": 34560000
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    },
    "EcmwfApiProviderConfig": {
      "description": "The config needed for the ECMWF API provider (who-am-i endpoint).",
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "browser": {
          "description": "Offers this provider as a direct browser sign-in method.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderBrowserConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "uri",
        "realm",
        "name"
      ]
    },
    "EcmwfTokenGeneratorProviderConfig": {
      "description": "Config for an ECMWF Token Generator provider that validates tokens through the token generator API.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "cert_uri": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "token_generator_url": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "cert_uri",
        "client_id",
        "client_secret",
        "token_generator_url",
        "realm"
      ]
    },
    "EFASApiProviderConfig": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "name",
        "realm"
      ]
    },
    "JWTAuthConfig": {
      "description": "JWT config structure for external usage",
      "type": "object",
      "properties": {
        "cert_uri": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "iam_realm": {
          "type": "string"
        }
      },
      "required": [
        "cert_uri",
        "realm",
        "name",
        "iam_realm"
      ]
    },
    "OpenIDOfflineProviderConfig": {
      "description": "Config for an OpenID provider that also supports offline tokens.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "cert_uri": {
          "type": "string"
        },
        "public_client_id": {
          "type": "string"
        },
        "private_client_id": {
          "type": "string"
        },
        "private_client_secret": {
          "type": "string"
        },
        "iam_url": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "cert_uri",
        "public_client_id",
        "private_client_id",
        "private_client_secret",
        "iam_url",
        "realm"
      ]
    },
    "PlainUserEntry": {
      "description": "Represents a single user entry (username + password).",
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "roles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "username",
        "password"
      ]
    },
    "PlainAuthConfig": {
      "description": "PlainAuthConfig defines the data for Basic authentication.",
      "type": "object",
      "properties": {
        "name": {
          "description": "A friendly name for logs.",
          "type": "string"
        },
        "realm": {
          "description": "The realm associated with this provider.",
          "type": "string"
        },
        "users": {
          "description": "A list of username/password pairs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlainUserEntry"
          }
        },
        "browser": {
          "description": "Offers this provider as a direct browser sign-in method.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderBrowserConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "realm",
        "users"
      ]
    },
    "AugmenterConfig": {
      "description": "Configuration options for augmenters (e.g. an LDAP roles augmenter).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ldap"
            }
          },
          "$ref": "#/$defs/LDAPAugmenterConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plain"
            }
          },
          "$ref": "#/$defs/PlainAugmenterConfig",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plain_advanced"
            }
          },
          "$ref": "#/$defs/PlainAdvancedAugmenterConfig",
          "required": [
            "type"
          ]
        }
      ]
    },
    "LDAPAugmenterConfig": {
      "description": "Configuration required to connect to LDAP and fetch user roles.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "search_base": {
          "type": "string"
        },
        "filter": {
          "type": [
            "string",
            "null"
          ]
        },
        "filters": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "bind_dn": {
          "type": [
            "string",
            "null"
          ]
        },
        "ldap_password": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "realm",
        "uri",
        "search_base",
        "ldap_password"
      ]
    },
    "PlainAugmenterConfig": {
      "description": "PlainAugmenterConfig defines the data for additional roles.",
      "type": "object",
      "properties": {
        "name": {
          "description": "A friendly name for logs.",
          "type": "string"
        },
        "realm": {
          "description": "The realm associated with this provider.",
          "type": "string"
        },
        "roles": {
          "description": "A list of roles and users.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "name",
        "realm",
        "roles"
      ]
    },
    "PlainAdvancedAugmenterMatcher": {
      "type": "object",
      "properties": {
        "username": {
          "description": "Users whose names trigger augmentation.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "role": {
          "description": "Existing roles that trigger augmentation.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "PlainAdvancedAugmenterAugment": {
      "type": "object",
      "properties": {
        "roles": {
          "description": "Roles to append (deduped).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "attributes": {
          "description": "Attributes to upsert (overwrite existing keys).",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "PlainAdvancedAugmenterConfig": {
      "description": "PlainAdvancedAugmenterConfig defines matching and augmentation rules.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "realm": {
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/PlainAdvancedAugmenterMatcher"
        },
        "augment": {
          "$ref": "#/$defs/PlainAdvancedAugmenterAugment"
        }
      },
      "required": [
        "name",
        "realm",
        "match",
        "augment"
      ]
    },
    "JWTConfig": {
      "description": "A simple definition for JWT usage in tokens.",
      "type": "object",
      "properties": {
        "iss": {
          "type": "string"
        },
        "aud": {
          "type": [
            "string",
            "null"
          ]
        },
        "exp": {
          "type": "integer",
          "format": "int64"
        },
        "secret": {
          "type": "string"
        }
      },
      "required": [
        "iss",
        "exp",
        "secret"
      ]
    },
    "LoggingConfig": {
      "description": "LoggingConfig controls how we initialize tracing/logging.",
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "service_name": {
          "type": "string",
          "default": "authotron"
        },
        "service_version": {
          "type": "string",
          "default": "0.3.7"
        }
      },
      "required": [
        "level",
        "format"
      ]
    },
    "AuthConfig": {
      "description": "Configuration for the authentication timeout.\nThis is used for select_ok operations in the auth module,\nand we kill ongoing futures if they take too long.\n\nNote:\n- The attribute `#[serde(default = \"default_timeout_in_ms\")]` ensures that if\n  the `timeout_in_ms` key is missing during deserialization, it gets set to 5000.\n- However, when the entire auth section is omitted, Serde calls `AuthConfig::default()`.\n  Therefore, we manually implement Default for AuthConfig so that AuthConfig::default()\n  returns a timeout of 5000 instead of the primitive default (0).",
      "type": "object",
      "properties": {
        "timeout_in_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 5000
        }
      }
    },
    "ConfigV1": {
      "type": "object",
      "properties": {
        "store": {
          "$ref": "#/$defs/StoreConfig"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceConfig"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderConfig"
          }
        },
        "augmenters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AugmenterConfig"
          },
          "default": []
        },
        "bind_address": {
          "type": "string"
        },
        "jwt": {
          "$ref": "#/$defs/JWTConfig"
        },
        "include_legacy_headers": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "logging": {
          "$ref": "#/$defs/LoggingConfig"
        },
        "auth": {
          "$ref": "#/$defs/AuthConfig",
          "default": {
            "timeout_in_ms": 5000
          }
        }
      },
      "required": [
        "store",
        "services",
        "providers",
        "bind_address",
        "jwt",
        "logging"
      ]
    },
    "ServerConfig": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "default": "0.0.0.0"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "port"
      ]
    },
    "MetricsConfig": {
      "description": "Controls the dedicated metrics/health server on a separate port.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 9090
        }
      }
    },
    "UiConfig": {
      "description": "Controls branding, trusted SSO links, and the shared direct-login session.\n\nDirect browser login methods are declared by `browser` blocks on `plain`\nand `ecmwf-api` providers and by OpenID Connect methods in `oidc`.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "branding": {
          "$ref": "#/$defs/BrandingConfig",
          "default": {
            "application_name": "Auth-O-Tron",
            "logo_url": null,
            "title": null,
            "description": null
          }
        },
        "sso": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrowserSignInAction"
          },
          "default": []
        },
        "oidc": {
          "description": "OpenID Connect sign-in methods, offered after provider methods.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/OidcMethodConfig"
          },
          "maxItems": 16
        },
        "browser_session": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserSessionConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "BrandingConfig": {
      "description": "Application-owned branding; all text is rendered as escaped plain text.",
      "type": "object",
      "properties": {
        "application_name": {
          "type": "string",
          "default": "Auth-O-Tron"
        },
        "logo_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiUrl"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "UiUrl": {
      "description": "A URL for escaped UI image and navigation attributes.\n\nHTTPS URLs and root-relative paths such as `/assets/aviso.png` are accepted.\nScheme-relative URLs such as `//other.example/logo.png`, script URLs such\nas `javascript:alert(1)`, and URLs containing credentials are rejected.",
      "type": "string"
    },
    "BrowserSignInAction": {
      "description": "An operator-configured entry into an application's browser login flow.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "start_url": {
          "$ref": "#/$defs/UiUrl"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "start_url"
      ]
    },
    "OidcMethodConfig": {
      "description": "One identity provider offered as a browser sign-in method. The redirect URI\nregistered at the provider is `<public_origin>/login/method/<id>/callback`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable method id shared with provider `browser` ids; used in routes and metrics.",
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "not": {
            "enum": [
              "callback",
              "new",
              "account"
            ]
          }
        },
        "label": {
          "description": "Chooser button text, trimmed, 1-64 characters, no control characters.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "realm": {
          "description": "Realm of identities signed in with this method; unique across providers.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "issuer": {
          "description": "Issuer identifier, compared exactly with the discovery document.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "client_auth": {
          "$ref": "#/$defs/OidcClientAuth",
          "default": "client_secret_basic"
        },
        "client_secret_file": {
          "description": "Absolute path of a file holding the client secret; required unless `client_auth` is `none`.",
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "description": "Scopes requested in addition to `openid`.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "default": []
        },
        "id_token_algorithms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IdTokenAlgorithm"
          },
          "minItems": 1,
          "maxItems": 9,
          "default": [
            "RS256",
            "PS256",
            "ES256"
          ]
        },
        "username_claim": {
          "$ref": "#/$defs/UsernameClaim",
          "default": "sub"
        },
        "roles_claim": {
          "description": "Dotted path to a string-array claim of upstream roles, e.g. `realm_access.roles`.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+){0,3}$"
        },
        "role_map": {
          "description": "Upstream role to local role; upstream roles without an entry are dropped.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 64
        },
        "max_authentication_age_seconds": {
          "description": "Sent as `max_age`; the ID token must then carry a recent enough `auth_time`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 60,
          "maximum": 86400
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/OidcPrompt"
            },
            {
              "type": "null"
            }
          ]
        },
        "additional_endpoint_origins": {
          "description": "Origins besides the issuer's that may host provider endpoints, e.g. a separate key host.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "default": []
        },
        "clock_skew_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 300,
          "default": 60
        },
        "http_timeout_ms": {
          "description": "Bound on each provider request, including connection setup.",
          "type": "integer",
          "format": "uint64",
          "minimum": 500,
          "maximum": 30000,
          "default": 5000
        },
        "refresh_max_lifetime_seconds": {
          "description": "Upper bound on the absolute lifetime of OAuth refresh-token families started\nby a login with this method; the client's `absolute_ttl_seconds` still applies.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 300,
          "maximum": 34560000
        },
        "offline_access": {
          "description": "Request `offline_access` for OAuth clients that set\n`refresh_tokens.upstream_offline_access`, coupling their refresh families to the\nprovider's offline session.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "realm",
        "issuer",
        "client_id"
      ]
    },
    "OidcClientAuth": {
      "description": "Token-endpoint client authentication.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "client_secret_basic",
            "client_secret_post"
          ]
        },
        {
          "description": "Public client; the code is protected by PKCE only.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "IdTokenAlgorithm": {
      "description": "Asymmetric JWS algorithms accepted for ID tokens; symmetric and `none` are never offered.",
      "type": "string",
      "enum": [
        "RS256",
        "RS384",
        "RS512",
        "PS256",
        "PS384",
        "PS512",
        "ES256",
        "ES384",
        "EdDSA"
      ]
    },
    "UsernameClaim": {
      "description": "Claim that becomes the Auth-O-Tron username. `email` requires `email_verified: true`.",
      "type": "string",
      "enum": [
        "sub",
        "preferred_username",
        "email"
      ]
    },
    "OidcPrompt": {
      "type": "string",
      "enum": [
        "login",
        "consent",
        "select_account"
      ]
    },
    "BrowserSessionConfig": {
      "description": "One origin and absolute session lifetime shared by all direct login flows.",
      "type": "object",
      "properties": {
        "public_origin": {
          "$ref": "#/$defs/UiUrl"
        },
        "session_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 60,
          "maximum": 86400,
          "default": 300
        },
        "backend": {
          "$ref": "#/$defs/BrowserBackendConfig"
        },
        "transaction_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 30,
          "maximum": 900,
          "default": 300
        },
        "max_forms": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 1024
        },
        "max_sessions": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 1024
        },
        "max_forms_per_window": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 120
        },
        "max_logins_per_window": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 60
        },
        "rate_window_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 3600,
          "default": 60
        },
        "max_inflight_logins": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 256,
          "default": 8
        },
        "max_shared_inflight_logins": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 1,
          "maximum": 65536,
          "default": null
        },
        "verification_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 30,
          "default": 10
        }
      },
      "additionalProperties": false,
      "required": [
        "public_origin",
        "backend"
      ]
    },
    "BrowserBackendConfig": {
      "description": "A single primary endpoint; Cluster and Sentinel discovery are not supported.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "memory"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "key_prefix": {
              "type": "string"
            },
            "password": {
              "type": "string",
              "writeOnly": true
            },
            "connect_timeout_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1,
              "maximum": 30000,
              "default": 2000
            },
            "operation_timeout_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1,
              "maximum": 10000,
              "default": 1000
            },
            "type": {
              "type": "string",
              "const": "valkey"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "key_prefix",
            "password"
          ]
        }
      ]
    },
    "OAuthConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "authorization_code_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 30,
          "maximum": 300,
          "default": 60
        },
        "access_token_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 60,
          "maximum": 3600,
          "default": 300
        },
        "authorization_transaction_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 30,
          "maximum": 900,
          "default": 300
        },
        "max_authorization_transactions": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 1024
        },
        "max_authorization_codes": {
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 100000,
          "default": 1024
        },
        "max_authentication_age_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 3600,
          "default": 300
        },
        "authentication_clock_skew_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 60,
          "default": 30
        },
        "max_refresh_token_families_per_user": {
          "description": "Live refresh-token families per user across all clients; issuing beyond the\ncap revokes that user's oldest family.",
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 1000,
          "default": 50
        },
        "endpoint_rate_limit": {
          "$ref": "#/$defs/OAuthEndpointRateLimit",
          "default": {
            "window_seconds": 60,
            "token_requests_per_window": 60,
            "revoke_requests_per_window": 30,
            "max_tracked_clients": 10000,
            "trusted_proxies": []
          }
        },
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OAuthClient"
          },
          "maxItems": 64,
          "default": []
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OAuthResource"
          },
          "maxItems": 64,
          "default": []
        },
        "signing": {
          "anyOf": [
            {
              "$ref": "#/$defs/OAuthSigningConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upstream_token_encryption": {
          "description": "Keys sealing the upstream refresh tokens of OIDC sign-ins coupled to refresh\nfamilies; keep them while coupled families may remain.",
          "anyOf": [
            {
              "$ref": "#/$defs/UpstreamTokenEncryptionConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "OAuthEndpointRateLimit": {
      "description": "Per-replica fixed-window limits for `/oauth/token` and `/oauth/revoke`, keyed by\nclient IP (IPv6 by /64). The client IP is the TCP peer unless that peer is in\n`trusted_proxies`; then it is the right-most `X-Forwarded-For` entry outside them.",
      "type": "object",
      "properties": {
        "window_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1,
          "maximum": 3600,
          "default": 60
        },
        "token_requests_per_window": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "maximum": 100000,
          "default": 60
        },
        "revoke_requests_per_window": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "maximum": 100000,
          "default": 30
        },
        "max_tracked_clients": {
          "description": "Client windows tracked across both endpoints; once full, untracked IPs are rejected.",
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "maximum": 1000000,
          "default": 10000
        },
        "trusted_proxies": {
          "description": "CIDRs of reverse proxies whose `X-Forwarded-For` is trusted, e.g. `10.0.0.0/8`.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "OAuthClient": {
      "description": "Locally preregistered public client; token endpoint authentication is `none`.",
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "display_name": {
          "type": "string"
        },
        "application_type": {
          "$ref": "#/$defs/ApplicationType",
          "default": "web"
        },
        "redirect_uris": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClientResource"
          },
          "maxItems": 64,
          "default": []
        },
        "refresh_tokens": {
          "$ref": "#/$defs/RefreshTokenPolicy",
          "default": {
            "enabled": false,
            "idle_ttl_seconds": 2592000,
            "absolute_ttl_seconds": 7776000,
            "upstream_offline_access": false
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "client_id",
        "display_name",
        "redirect_uris"
      ]
    },
    "ApplicationType": {
      "description": "Uses the OpenID Connect `application_type` terminology.",
      "type": "string",
      "enum": [
        "web",
        "native"
      ]
    },
    "ClientResource": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "scopes"
      ]
    },
    "RefreshTokenPolicy": {
      "description": "Per-client opt-in for rotating refresh tokens. A family ends at the earlier of\n`idle_ttl_seconds` after its last use and `absolute_ttl_seconds` after the login.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "idle_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 300,
          "maximum": 34560000,
          "default": 2592000
        },
        "absolute_ttl_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 300,
          "maximum": 34560000,
          "default": 7776000
        },
        "upstream_offline_access": {
          "description": "Couple each family started by an OIDC sign-in with `offline_access` to the\nprovider's offline session: refreshes renew it, and the family ends with it.\nRequires `enabled` and `oauth.upstream_token_encryption`.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "OAuthResource": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string"
        },
        "allowed_realms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceScope"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "allowed_realms",
        "scopes"
      ]
    },
    "ResourceScope": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "required_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "required_roles"
      ]
    },
    "OAuthSigningConfig": {
      "type": "object",
      "properties": {
        "active_kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OAuthSigningKey"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "additionalProperties": false,
      "required": [
        "active_kid",
        "keys"
      ]
    },
    "OAuthSigningKey": {
      "description": "Admin-selected paths only; key contents are never part of the config contract.",
      "type": "object",
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "private_key_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_key_file": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kid"
      ]
    },
    "UpstreamTokenEncryptionConfig": {
      "description": "AES-256 keys for upstream refresh tokens. New tokens are sealed with `active_kid`;\nthe other keys only open tokens sealed before a rotation.",
      "type": "object",
      "properties": {
        "active_kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UpstreamTokenKey"
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "additionalProperties": false,
      "required": [
        "active_kid",
        "keys"
      ]
    },
    "UpstreamTokenKey": {
      "description": "One key: a file holding 32 random bytes in standard Base64, such as\n`openssl rand -base64 32` writes.",
      "type": "object",
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "key_file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kid",
        "key_file"
      ]
    },
    "ConfigV2": {
      "type": "object",
      "properties": {
        "store": {
          "$ref": "#/$defs/StoreConfig"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceConfig"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderConfig"
          }
        },
        "augmenters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AugmenterConfig"
          },
          "default": []
        },
        "server": {
          "$ref": "#/$defs/ServerConfig"
        },
        "metrics": {
          "$ref": "#/$defs/MetricsConfig",
          "default": {
            "enabled": true,
            "port": 9090
          }
        },
        "jwt": {
          "$ref": "#/$defs/JWTConfig"
        },
        "include_legacy_headers": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "logging": {
          "$ref": "#/$defs/LoggingConfig"
        },
        "auth": {
          "$ref": "#/$defs/AuthConfig",
          "default": {
            "timeout_in_ms": 5000
          }
        },
        "ui": {
          "$ref": "#/$defs/UiConfig",
          "default": {
            "enabled": false,
            "branding": {
              "application_name": "Auth-O-Tron",
              "logo_url": null,
              "title": null,
              "description": null
            },
            "sso": []
          }
        },
        "oauth": {
          "$ref": "#/$defs/OAuthConfig",
          "default": {
            "enabled": false,
            "issuer": null,
            "authorization_code_ttl_seconds": 60,
            "access_token_ttl_seconds": 300,
            "authorization_transaction_ttl_seconds": 300,
            "max_authorization_transactions": 1024,
            "max_authorization_codes": 1024,
            "max_authentication_age_seconds": 300,
            "authentication_clock_skew_seconds": 30,
            "max_refresh_token_families_per_user": 50,
            "endpoint_rate_limit": {
              "window_seconds": 60,
              "token_requests_per_window": 60,
              "revoke_requests_per_window": 30,
              "max_tracked_clients": 10000,
              "trusted_proxies": []
            },
            "clients": [],
            "resources": [],
            "signing": null,
            "upstream_token_encryption": null
          }
        }
      },
      "required": [
        "store",
        "services",
        "providers",
        "server",
        "jwt",
        "logging"
      ]
    }
  }
}
